{
  "name": "@utkristi/ui",
  "version": "0.1.0",
  "description": "The shared component library and design tokens for the Utkristi ecosystem.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "files": ["dist", "CHANGELOG.md", "DESIGN_TOKENS.md"],
  "types": "./dist/react/index.d.ts",
  "exports": {
    ".": { "types": "./dist/react/index.d.ts", "import": "./dist/react/index.js" },
    "./preset": {
      "import": { "types": "./dist/tailwind/preset.d.ts", "default": "./dist/tailwind/preset.js" },
      "require": { "types": "./dist/tailwind/preset.d.cts", "default": "./dist/tailwind/preset.cjs" }
    },
    "./plugin": {
      "import": { "types": "./dist/tailwind/plugin.d.ts", "default": "./dist/tailwind/plugin.js" },
      "require": { "types": "./dist/tailwind/plugin.d.cts", "default": "./dist/tailwind/plugin.cjs" }
    },
    "./tokens": {
      "import": { "types": "./dist/tokens.d.ts", "default": "./dist/tokens.js" },
      "require": { "types": "./dist/tokens.d.cts", "default": "./dist/tokens.cjs" }
    },
    "./utkristi-ui.css": "./dist/utkristi-ui.css",
    "./css": "./dist/utkristi-ui.css",
    "./utkristi-ui.min.css": "./dist/utkristi-ui.min.css",
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && npm run build:css && npm run build:tailwind && npm run build:react",
    "build:css": "node scripts/build-css.mjs",
    "build:tailwind": "node scripts/build-tailwind.mjs",
    "build:react": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "docs": "vite --config docs/vite.config.ts",
    "docs:build": "vite build --config docs/vite.config.ts",
    "docs:preview": "vite preview --config docs/vite.config.ts",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "peerDependencies": {
    "lucide-react": ">=0.468",
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=3.4"
  },
  "peerDependenciesMeta": {
    "lucide-react": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true },
    "tailwindcss": { "optional": true }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.4.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^9.25.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.468.0",
    "postcss": "^8.5.3",
    "postcss-js": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
