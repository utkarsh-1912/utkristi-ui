{
  "name": "@utkristi/ui",
  "version": "0.1.10",
  "description": "Live-data and collaborative workstation UI for React, Tailwind CSS and plain HTML.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/react/elements.js"
  ],
  "files": [
    "dist",
    "bin",
    "CHANGELOG.md",
    "DESIGN_TOKENS.md",
    "src/react/Ticker.tsx"
  ],
  "bin": {
    "utkristi-ui": "./bin/utkristi-ui.mjs"
  },
  "types": "./dist/react/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./theme-engine": {
      "types": "./dist/react/theme-engine/index.d.ts",
      "import": "./dist/react/theme-engine/index.js"
    },
    "./collab-yjs": {
      "types": "./dist/react/collab/yjs.d.ts",
      "import": "./dist/react/collab/yjs.js"
    },
    "./collab-liveblocks": {
      "types": "./dist/react/collab/liveblocks.d.ts",
      "import": "./dist/react/collab/liveblocks.js"
    },
    "./collab-ws": {
      "types": "./dist/react/collab/ws.d.ts",
      "import": "./dist/react/collab/ws.js"
    },
    "./dom": {
      "types": "./dist/react/dom.d.ts",
      "import": "./dist/react/dom.js"
    },
    "./elements": {
      "types": "./dist/react/elements.d.ts",
      "import": "./dist/react/elements.js"
    },
    "./preset": {
      "import": {
        "types": "./dist/tailwind/preset.d.ts",
        "default": "./dist/tailwind/preset.js"
      },
      "require": {
        "types": "./dist/tailwind/preset.d.cts",
        "default": "./dist/tailwind/preset.cjs"
      }
    },
    "./plugin": {
      "import": {
        "types": "./dist/tailwind/plugin.d.ts",
        "default": "./dist/tailwind/plugin.js"
      },
      "require": {
        "types": "./dist/tailwind/plugin.d.cts",
        "default": "./dist/tailwind/plugin.cjs"
      }
    },
    "./tokens": {
      "import": {
        "types": "./dist/tokens.d.ts",
        "default": "./dist/tokens.js"
      },
      "require": {
        "types": "./dist/tokens.d.cts",
        "default": "./dist/tokens.cjs"
      }
    },
    "./utkristi-ui.css": "./dist/utkristi-ui.css",
    "./css": "./dist/utkristi-ui.css",
    "./utkristi-ui.min.css": "./dist/utkristi-ui.min.css",
    "./css/*": "./dist/css/*",
    "./tailwind.css": "./dist/tailwind.css",
    "./utkristi-ui.layered.css": "./dist/utkristi-ui.layered.css",
    "./utkristi-ui.layered.min.css": "./dist/utkristi-ui.layered.min.css",
    "./scoped.css": "./dist/scoped.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./style-dictionary.config.json": "./dist/style-dictionary.config.json",
    "./fonts.css": "./dist/fonts.css",
    "./icons": {
      "types": "./dist/react/icons-entry.d.ts",
      "import": "./dist/react/icons-entry.js"
    },
    "./icons/*": "./dist/icons/*",
    "./package.json": "./package.json",
    "./live-data": {
      "types": "./dist/react/LiveData.d.ts",
      "import": "./dist/react/LiveData.js"
    },
    "./collab": {
      "types": "./dist/react/collab-entry.d.ts",
      "import": "./dist/react/collab-entry.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "icons": "node scripts/build-icons.mjs",
    "icons:3d": "python scripts/render-3d.py",
    "icons:formats": "python scripts/encode-icon-assets.py",
    "build": "npm run clean && npm run build:assets",
    "build:assets": "npm run icons && npm run build:css && npm run build:tailwind && npm run build:react",
    "build:css": "node scripts/build-css.mjs",
    "build:tailwind": "node scripts/build-tailwind.mjs",
    "build:react": "tsc -p tsconfig.build.json",
    "build:mcp": "node scripts/build-mcp.mjs",
    "test:mcp": "npm run build:mcp && node --test packages/ui-mcp/test/*.test.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build:assets",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "predocs": "npm run icons",
    "docs": "vite --config docs/vite.config.ts",
    "predocs:build": "npm run icons",
    "docs:build": "vite build --config docs/vite.config.ts",
    "docs:preview": "vite preview --config docs/vite.config.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "screenshots:capture": "node scripts/screenshots.mjs --capture-only",
    "docs:verify": "node scripts/screenshots.mjs --verify-only",
    "docs:visual": "node scripts/screenshots.mjs --verify-only --visual-matrix",
    "smoke:package": "node scripts/smoke-package.mjs",
    "smoke:next": "node scripts/smoke-next.mjs",
    "check:bundles": "node scripts/check-bundles.mjs",
    "docs:stress": "node scripts/screenshots.mjs --stress",
    "docs:audit": "node scripts/audit-components.mjs",
    "bench": "node scripts/benchmark.mjs"
  },
  "peerDependencies": {
    "lucide-react": ">=0.468",
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=3.4"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.4.0",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.14.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.25.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.468.0",
    "parse5": "^7.3.0",
    "postcss": "^8.5.3",
    "postcss-js": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sucrase": "^3.35.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/utkarsh-1912/utkristi-ui.git"
  },
  "homepage": "https://utkristi-ui.vercel.app/",
  "bugs": {
    "url": "https://github.com/utkarsh-1912/utkristi-ui/issues"
  },
  "keywords": [
    "design-system",
    "trading-ui",
    "live-data",
    "collaboration",
    "react",
    "tailwindcss",
    "web-components",
    "mcp"
  ]
}
